From 40e33a41a77c80b71d355b2e05a1c5ba033fc442 Mon Sep 17 00:00:00 2001
From: jimmy-mcelwain <jimmy.mcelwain@motoman.com>
Date: Wed, 14 Oct 2026 10:31:17 -0400
Subject: [PATCH] Lower C/C++ standard requirements for MotoPlus GCC 4.3

---
 ament_cmake_ros_core/cmake/ament_ros_defaults.cmake | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ament_cmake_ros_core/cmake/ament_ros_defaults.cmake b/ament_cmake_ros_core/cmake/ament_ros_defaults.cmake
index 8c37c1d..5805f79 100644
--- a/ament_cmake_ros_core/cmake/ament_ros_defaults.cmake
+++ b/ament_cmake_ros_core/cmake/ament_ros_defaults.cmake
@@ -13,10 +13,10 @@
 # limitations under the License.
 
 add_library(ament_ros_cxx_standard INTERFACE)
-target_compile_features(ament_ros_cxx_standard INTERFACE cxx_std_20)
+#target_compile_features(ament_ros_cxx_standard INTERFACE cxx_std_20)
 
 add_library(ament_ros_c_standard INTERFACE)
-target_compile_features(ament_ros_c_standard INTERFACE c_std_17)
+target_compile_features(ament_ros_c_standard INTERFACE c_std_99)
 
 add_library(ament_ros_defaults INTERFACE)
 target_link_libraries(ament_ros_defaults INTERFACE
-- 
